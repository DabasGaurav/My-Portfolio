# Copy to .env.local and fill in as each milestone needs it.
# Nothing in this file is required for Milestone 1.

# The site's own URL. Leave unset locally (defaults to localhost).
# In Vercel, set this to the deployed URL; update it again once
# gauravdabas.in is connected — see config/site.config.ts.
NEXT_PUBLIC_SITE_URL=

# --- Milestone 3: GitHub live embed ---
# Required for "Currently Cooking" (pinned repos) — GitHub's GraphQL API
# needs an authenticated token for every request, even for public data.
# A classic PAT with no scopes works fine (public read-only). Without
# this, the section falls back to your most-recently-updated repos
# instead of your actual pinned/featured ones.
GITHUB_TOKEN=

# --- Milestone 6: RAG chatbot ---
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=

# --- Milestone 5: analytics ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Milestone 7: crossposting agent ---
# Optional. Vercel sets this automatically for cron-triggered requests
# once you add it here (Project Settings -> Environment Variables) — it
# just stops random visitors from hitting /api/crosspost directly. Any
# random string works; generate one with `openssl rand -hex 32`.
CRON_SECRET=
