# Copy to .env.local and fill in as each milestone needs it.
# Nothing in this file is required for Milestone 1.

# The site's own URL. Leave unset locally (defaults to localhost).
# In Vercel, set this to the deployed URL; update it again once
# gauravdabas.com is connected — see config/site.config.ts.
NEXT_PUBLIC_SITE_URL=

# --- Milestone 3: GitHub live embed ---
# Optional. A fine-grained PAT with no scopes (public read-only) raises
# the unauthenticated 60 req/hr rate limit.
GITHUB_TOKEN=

# --- Milestone 6: RAG chatbot ---
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=

# --- Milestone 5: analytics ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
